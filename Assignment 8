# Function to count the number of lines
def count_lines(input_path):
    with open(input_path, "r") as f:
        return sum(1 for _ in f)


# Function to get the first n lines
def extract_first_lines(input_path, n=2):
    first_lines = []
    with open(input_path, "r") as f:
        for i, line in enumerate(f):
            if i >= n:
                break
            first_lines.append(line)
    return first_lines


# Function to write lines into a new file
def write_lines(output_path, lines):
    with open(output_path, "w") as f:
        f.writelines(lines)


# Main program
if __name__ == "__main__":
    input_path = "input.txt"
    output_path = "output_first_two_lines.txt"

    # Creating a sample input file
    sample_content = (
        "Piyush: Python practical\n"
        "Piyush: File handling assignment\n"
        "Wednesday: Code practice\n"
        "Thursday: College work\n"
        "Friday: Project work\n"
    )

    with open(input_path, "w") as f:
        f.write(sample_content)

    print(f"Created sample input file: {input_path}")

    # Count total lines
    total_lines = count_lines(input_path)
    print(f"Total number of lines in '{input_path}': {total_lines}")

    # Get first two lines
    first_two = extract_first_lines(input_path, n=2)
    print("\nFirst two lines extracted:")
    for line in first_two:
        print(line.rstrip())

    # Write first two lines to a new file
    write_lines(output_path, first_two)
    print(f"\nExtracted lines written to: {output_path}")

    # Display the output file
    print(f"\nContents of '{output_path}':")
    with open(output_path, "r") as f:
        print(f.read())
